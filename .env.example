# 기본값: <repo>/data
ANB_DATA_DIR=/absolute/path/to/auto-naver-blog/data

# 기본값: claude
ANB_CLAUDE_BIN=claude

# 기본값: aside
ANB_ASIDE_BIN=aside

# 아래 두 값은 `npm run naver:login` 이 로그인 성공 후 자동으로 .env 에 기록한다.
# 직접 적을 필요는 없다 — 적어 두면 그 값이 우선한다.
# 기본값: null (미설정)
NAVER_BLOG_ID=your-naver-blog-id

# 로그인한 블로그의 카테고리 이름 목록(쉼표 구분). 현재는 참고용이며 앱이 읽지는 않는다 —
# 업로드 화면에 입력할 카테고리 이름을 확인하는 용도다.
NAVER_BLOG_CATEGORIES="카테고리1,카테고리2"

# 기본값: <ANB_DATA_DIR>/naver-cookies.json
ANB_COOKIE_FILE=/absolute/path/to/auto-naver-blog/data/naver-cookies.json

# 기본값: 600000 (10분, ms)
ANB_CLAUDE_TIMEOUT_MS=600000

# 기본값: 60000 (1분, ms)
ANB_ASIDE_STEP_TIMEOUT_MS=60000
