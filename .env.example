# 기본값: <repo>/data
ANB_DATA_DIR=/absolute/path/to/auto-naver-blog/data

# 기본값: claude
ANB_CLAUDE_BIN=claude

# 기본값: aside
ANB_ASIDE_BIN=aside

# 아래 두 값은 `npm run naver:login` 이 로그인 성공 후 자동으로 .env 에 기록한다.
# 직접 적을 필요는 없다 — 적어 두면 그 값이 우선한다.
# 기본값: null (미설정)
NAVER_BLOG_ID=your-naver-blog-id

# 로그인한 블로그의 카테고리 이름 목록(쉼표 구분). 현재는 참고용이며 앱이 읽지는 않는다 —
# 업로드 화면에 입력할 카테고리 이름을 확인하는 용도다.
NAVER_BLOG_CATEGORIES="카테고리1,카테고리2"

# 기본값: <ANB_DATA_DIR>/naver-cookies.json
ANB_COOKIE_FILE=/absolute/path/to/auto-naver-blog/data/naver-cookies.json

# 기본값: 600000 (10분, ms)
ANB_CLAUDE_TIMEOUT_MS=600000

# 기본값: 60000 (1분, ms)
ANB_ASIDE_STEP_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────────
# 여럿이 함께 쓸 때 — 인증과 바인딩 (자세한 내용은 README 참고)
# ─────────────────────────────────────────────────────────────

# 공유 비밀번호. 이 값을 아는 사람만 앱을 쓸 수 있다 (8자 이상).
# 비워 두면 인증이 꺼지고, 그때는 루프백에만 뜬다 — 외부 바인딩이면 부팅을 거부한다.
# 기본값: 미설정 (인증 꺼짐)
ANB_ACCESS_PASSWORD=

# 관리자 비밀번호 (8자 이상, 위와 달라야 한다). 네이버 로그인·재로그인·라이브 확인은
# 이 비밀번호로 들어온 사람만 할 수 있다. 비워 두면 화면에서는 아무도 네이버 로그인을 할 수
# 없고, 터미널에서 `npm run naver:login` 으로만 한다.
# 기본값: 미설정
ANB_ADMIN_PASSWORD=

# 세션 쿠키 서명 키 (32자 이상). `openssl rand -hex 32` 로 만든다.
# ANB_ACCESS_PASSWORD 를 설정했다면 이 값이 없으면 서버가 뜨지 않는다.
# 기본값: 미설정
ANB_SESSION_SECRET=

# 바인딩 주소. 127.0.0.1 이면 이 기계에서만 열린다. 사내망·외부에 열려면 0.0.0.0.
# 루프백이 아닌 값은 위 인증 설정이 갖춰져 있어야만 뜬다.
# 기본값: 127.0.0.1
ANB_HOST=127.0.0.1
